{
  "name": "internpath",
  "private": true,
  "version": "0.1.0",
  "description": "University Internship Platform (InternPath) — monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "pnpm --filter \"./libs/*\" build",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "infra:up": "docker compose --profile infra up -d",
    "infra:down": "docker compose --profile infra down"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.6.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@types/chai": "^4",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "chai": "^4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "sinon": "^22.1.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.2"
  }
}
