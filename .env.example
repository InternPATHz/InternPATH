# ===== Infra (docker compose) =====
POSTGRES_USER=internpath
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_USER=internpath
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://internpath:change-me@localhost:5672
# ตอนสาธิตใช้ CloudAMQP: RABBITMQ_URL=amqps://<user>:<password>@<host>.cloudamqp.com/<vhost>

MINIO_ROOT_USER=internpath
MINIO_ROOT_PASSWORD=change-me-too-12345
# ตอนสาธิตใช้ Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com (ต้องใช้ R2 เพราะ Signed URL ต้องเปิดจากเบราว์เซอร์ได้)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET_PUBLIC=internpath-public
S3_BUCKET_PRIVATE=internpath-private
S3_ACCESS_KEY=internpath
S3_SECRET_KEY=change-me-too-12345

# Mailpit (ดักอีเมลในเครื่อง) — ใช้ได้ทั้งตอนพัฒนาและสาธิตบนเครื่องเดียว
# ถ้าต้องให้คนอื่นรับอีเมลจริง ให้เปลี่ยนเป็น SMTP จริงและเพิ่ม SMTP_USER / SMTP_PASSWORD
SMTP_HOST=localhost
SMTP_PORT=1025

# ===== Database URLs (1 DB ต่อ Service) =====
# Postgres ใน Docker ไม่มี connection pooler: DATABASE_URL กับ DIRECT_URL ใช้ค่าเดียวกัน
IDENTITY_DATABASE_URL=postgresql://internpath:change-me@localhost:5432/identity_db
IDENTITY_DIRECT_URL=postgresql://internpath:change-me@localhost:5432/identity_db
JOB_DATABASE_URL=postgresql://internpath:change-me@localhost:5432/job_db
JOB_DIRECT_URL=postgresql://internpath:change-me@localhost:5432/job_db
VERIFICATION_DATABASE_URL=postgresql://internpath:change-me@localhost:5432/verification_db
VERIFICATION_DIRECT_URL=postgresql://internpath:change-me@localhost:5432/verification_db
LIFECYCLE_DATABASE_URL=postgresql://internpath:change-me@localhost:5432/lifecycle_db
LIFECYCLE_DIRECT_URL=postgresql://internpath:change-me@localhost:5432/lifecycle_db
NOTIFICATION_DATABASE_URL=postgresql://internpath:change-me@localhost:5432/notification_db
NOTIFICATION_DIRECT_URL=postgresql://internpath:change-me@localhost:5432/notification_db

# ===== Auth =====
# สร้างคู่คีย์ RS256 เองแล้วใส่ที่นี่ (ห้าม commit) — Open Decision #2: env หรือ JWKS
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
# Service Token (ใช้เรียก /internal/**)
SERVICE_TOKEN_SECRET=change-me

# ===== Service URLs =====
GATEWAY_URL=http://localhost:3000
IDENTITY_URL=http://localhost:3001
JOB_URL=http://localhost:3002
VERIFICATION_URL=http://localhost:3003
LIFECYCLE_URL=http://localhost:3004
NOTIFICATION_URL=http://localhost:3005

# ===== สาธิตผ่าน Cloudflare (ดู docs/architecture.md §8.1) =====
# หมายเหตุ: ตัวแปรกลุ่มนี้ยังไม่มีโค้ดอ่าน — กำหนดไว้ล่วงหน้า
# URL ของ Front บน Cloudflare (ใช้สร้างลิงก์ในอีเมล ห้ามเป็น localhost เมื่อให้คนอื่นกด)
WEB_BASE_URL=http://localhost:3100
# ค่าลับร่วมระหว่าง Worker proxy กับ gateway (header X-Edge-Secret) — สุ่มค่ายาวๆ ห้าม commit
EDGE_SHARED_SECRET=
# origin ที่อนุญาตให้เรียก gateway ตรง (คั่นด้วย ,) — ห้ามใช้ *
CORS_ALLOWED_ORIGINS=http://localhost:3100
# API_ORIGIN (URL ของ tunnel/เซิร์ฟเวอร์ backend) ตั้งเป็นตัวแปรของ Cloudflare Worker ไม่ใช่ใน .env นี้

# ===== Timezone / SLA =====
TZ=Asia/Bangkok
